# Jekyll ignore
_site/
.sass-cache/
.jekyll-cache/
.jekyll-metadata

# Bundler ignore
.bundle/
vendor/
Gemfile.lock

# OS metadata
.DS_Store
**/.DS_Store

# Playwright logs and outputs
.playwright-cli/
**/_site/
**/output/playwright/
output/playwright/

# Confidential double-blind review copies
/papers/nips/*.pdf
# PDFs dropped at the repository root are local drafts, not public downloads.
/*.pdf

# Local build output and recoverable workspace archives
/.build/
/.local/

# Independently versioned project checkout, not homepage source.
/projects/Image2Other/

# LaTeX intermediate files (keep sources, bibliography .bbl files and PDFs)
*.aux
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.run.xml
*.synctex.gz
*.synctex(busy)
*.toc
*.xdv

# The legacy CV is a local reference; the main CV PDFs are published.
/cv/cheng-chen-cv-legacy.pdf
